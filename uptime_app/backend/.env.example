HTTP_ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://uptime:uptime_local@127.0.0.1:55432/uptime?sslmode=disable
DB_MAX_OPEN=10
DB_MAX_IDLE=5
DB_CONN_LIFETIME=30m
# Generate each independently: openssl rand -base64 32
JWT_SECRET=
MAIL_ENCRYPTION_KEY=
JWT_ISSUER=uptime-api
JWT_AUDIENCE=uptime-web
# Exact allowed browser origin for CORS and cookie authentication (no wildcard).
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
SMTP_ADDR=127.0.0.1:1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
SMTP_ALLOW_INSECURE=true
# Optional: enables only the authenticated Next.js proxy header.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Same random value in frontend/.env.local; generate with openssl rand -hex 32
PROXY_SECRET=

# Persistent avatar storage, relative to the backend working directory.
# Multiple API instances require the same shared volume.
# Unreferenced files older than 24h are collected hourly.
AVATAR_DIR=uploads/avatars

  "name": "uptime-toolkit",
  "version": "0.1.0",
  "description": "Проектные скиллы для разработки uptime_app.",
  "author": {
    "name": "Asanbek Samudin"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Uptime Toolkit",
        "shortDescription": "Скиллы проекта uptime_app",
